# Copie para .env.local (ignorado pelo git) e ajuste.
#
# fixture → demo-pack REAL pré-calculado em public/demo-pack/ (Uberlândia, NASA POWER 2001–2024; grade em
#           index.json, gerada por apps/api/scripts/export_demo_pack.py). Fora da grade: "não pré-calculado".
# api     → chama a API FastAPI em VITE_GAIAPUS_API_URL (cd apps/api && uvicorn main:app).
VITE_DATA_SOURCE=fixture
VITE_GAIAPUS_API_URL=http://localhost:8000
